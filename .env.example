# ---------------------------------------------------------------------------
# EdgeSense configuration. Copy to `.env` and fill in.
# Everything here has a working default EXCEPT the Azure block; with no Azure
# credentials the worker falls back to the deterministic offline provider so
# `docker compose up` and the eval harness still run end to end.
# ---------------------------------------------------------------------------

# --- Azure OpenAI (generation: agent loop, summaries, classification) -------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Search (retrieval backing the lookup_policy tool) -------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=edgesense-policies

# Provider selection: azure | offline | auto
# `auto` uses Azure when credentials are present, offline otherwise.
EDGESENSE_LLM_PROVIDER=auto

# --- Pipeline endpoints -----------------------------------------------------
INGEST_WS_URL=ws://localhost:8080/v1/stream
INGEST_HTTP_ADDR=:8080
KAFKA_BROKERS=localhost:9092
REDIS_ADDR=localhost:6379
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DB=edgesense
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Topics -----------------------------------------------------------------
TOPIC_SEGMENTS=transcript.segments
TOPIC_INSIGHTS=call.insights

# --- Edge agent -------------------------------------------------------------
WHISPER_MODEL=tiny.en
WHISPER_COMPUTE_TYPE=int8
FRAME_MS=20
EDGE_REALTIME=1

# --- Observability ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAMESPACE=edgesense
PROMETHEUS_PORT=9100
LOG_LEVEL=info
